cython_debug/

# PyCharm
#  JetBrains specific template is maintainted in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Project data
data/

# Post-processing MP4 exports (clips / stabilized movies)
exports/

# Cached ephemeris
tle_cache.tle*
de421.bsp*
# Disk-backed trajectory cache (regenerated at launch; ~16 MB)
trajectory_disk_cache.npz*
# Binary cache of parsed launch/tracking trajectory files (regenerated from sources)
launches/.traj_cache/
# Hipparcos star catalogue (downloaded by skyfield for star_catalog.py / tetra3 DB build)
hip_main.dat*
# Tycho catalogue (downloaded from CDS for deep/narrow-FOV star rendering + tetra3 DB)
tyc_main.dat*
# Local config backup written by ConfigState.save_to_file()
config.json.bak

# RTL-SDR / librtlsdr native binaries (provided by the pyrtlsdrlib wheel, or
# dropped in locally for the ADS-B receiver). Platform-specific; never commit.
rtlsdr.dll
rtlsdr*.lib
rtlsdr.exp
libusb-1.0.dll
libusb-1.0.lib
libusb-1.0.exp
libusb-1.0.pdb
convenience_static.lib
libgetopt_static.lib
pthreadVC2.dll
msvcr100.dll

# Live user config (per-site coordinates, tuned gains). The committed
# template is config.example.json; the app falls back to it when config.json
# is absent and Save creates the real file.
config.json
config.json.bak
